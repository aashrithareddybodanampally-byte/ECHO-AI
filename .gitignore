# ============================================================
# ECHO-AI .gitignore
# ============================================================

# -----------------------------------------------
# Python
# -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# MyPy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------
# Node / Frontend
# -----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/

# -----------------------------------------------
# Environment variables & Secrets
# -----------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt
*.p12

# -----------------------------------------------
# IDE / Editors
# -----------------------------------------------
# VS Code — ignore user-specific, allow shared config
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# -----------------------------------------------
# Operating Systems
# -----------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------------------------------------
# ML / Data / Models
# -----------------------------------------------
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.safetensors

# Large datasets (keep READMEs)
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep
data/processed/*
!data/processed/README.md
!data/processed/.gitkeep

# Trained models directory (keep README)
models/*
!models/README.md
!models/.gitkeep

# -----------------------------------------------
# Logs
# -----------------------------------------------
logs/*
!logs/.gitkeep
*.log

# -----------------------------------------------
# Docker
# -----------------------------------------------
*.pid
docker-compose.override.yml

# -----------------------------------------------
# Miscellaneous
# -----------------------------------------------
*.bak
*.tmp
*.temp
.cache/
.parcel-cache/
