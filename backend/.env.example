APP_NAME=ECHO-AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# PostgreSQL (run `alembic upgrade head`), or for quick local use:
# DATABASE_URL=sqlite:///./echo_ai_dev.db   (schema created automatically at startup)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/echo_ai

SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Maximum audio upload size in bytes (default 25 MB)
MAX_AUDIO_UPLOAD_BYTES=26214400

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Voice emotion model artifact (train with: python -m ml.training.train_voice_emotion)
# VOICE_EMOTION_MODEL_PATH=../models/emotion_model_v1.pkl

# Speech-to-text (faster-whisper; model downloads from Hugging Face on first use)
STT_ENABLED=true
WHISPER_MODEL_SIZE=base

# LLM: auto = Groq if GROQ_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set,
# else the labeled offline responder. Or force: groq | anthropic | offline
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=2048

CONTEXT_MAX_MESSAGES=10
CONTEXT_MAX_CHARS=6000
RAG_TOP_K=3
