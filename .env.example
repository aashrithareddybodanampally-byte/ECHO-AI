# ============================================================
# ECHO-AI — Environment Variables Template
# ============================================================
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual values.
#   3. NEVER commit .env to version control.
#
# ============================================================

# ----- Application -----
APP_ENV=development
APP_NAME=ECHO-AI
APP_VERSION=0.1.0
APP_DEBUG=true

# ----- Backend (FastAPI) -----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=true

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql://user:password@localhost:5432/echo_ai
DATABASE_POOL_SIZE=5

# ----- Authentication -----
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ----- LLM Integration -----
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ----- Vector Database (RAG) -----
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=echo_ai_embeddings

# ----- Speech / Audio -----
WHISPER_MODEL_SIZE=base
AUDIO_SAMPLE_RATE=16000

# ----- Storage -----
STORAGE_PATH=./data
MODEL_STORAGE_PATH=./models

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/echo_ai.log

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Redis (optional cache/queue) -----
REDIS_URL=redis://localhost:6379/0
